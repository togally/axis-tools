{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axis.tools/schemas/project-init-inspection.schema.json",
  "title": "Axis project initialization inspection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "repo",
    "source_contract_version",
    "latest_contract_version",
    "selectors",
    "files",
    "migration_chain",
    "fields",
    "environment",
    "provenance",
    "resolutions",
    "recommendations",
    "options"
  ],
  "properties": {
    "schema": { "const": "axis.project_init_inspection" },
    "schema_version": { "const": 1 },
    "repo": { "type": "string", "minLength": 1 },
    "source_contract_version": { "type": ["string", "null"], "enum": ["0.1", "0.2", null] },
    "latest_contract_version": { "const": "0.2" },
    "status": { "enum": ["ok", "recovery_required"] },
    "recovery_required": { "type": "boolean" },
    "selectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "organization_id", "oss_profile"],
      "properties": {
        "registry_path": { "type": "string", "minLength": 1 },
        "organization_id": { "type": ["string", "null"] },
        "oss_profile": { "type": ["string", "null"] }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "state", "sha256"],
        "properties": {
          "role": { "enum": ["main_config", "local_config", "target_registry", "source_registry", "gitignore"] },
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["present", "absent"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "migration_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "mapping"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "mapping": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "required", "resolution", "provenance"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "current_value": {},
          "mapped_value": {},
          "recommendation": {},
          "options": { "type": "array" },
          "resolution": { "enum": ["stored", "mapped", "recommended", "unresolved", "remove"] },
          "disposition": { "enum": ["keep", "remove"] },
          "removal_reason": { "type": "string" },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "source"],
              "properties": {
                "version": { "type": "string" },
                "source": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "environment": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "name", "required", "present"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "name": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "present": { "type": "boolean" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "source"],
          "properties": {
            "version": { "type": "string" },
            "source": { "type": "string" }
          }
        }
      }
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": { "enum": ["stored", "mapped", "recommended", "unresolved", "remove"] }
    },
    "recommendations": {
      "type": "object",
      "additionalProperties": {}
    },
    "options": {
      "type": "object",
      "additionalProperties": { "type": "array" }
    }
  }
}
