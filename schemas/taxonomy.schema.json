{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axis-tools.example/schemas/taxonomy.schema.json",
  "title": "Axis public taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roles", "phases", "domains", "safety_labels"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "roles": {
      "$ref": "#/$defs/slugs"
    },
    "phases": {
      "$ref": "#/$defs/slugs"
    },
    "domains": {
      "$ref": "#/$defs/slugs"
    },
    "safety_labels": {
      "$ref": "#/$defs/slugs"
    }
  },
  "$defs": {
    "slugs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  }
}
