{
  "name": "axis-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "axis": "./dist/cli.js",
    "axis-tools": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "test": "npm run test:cli && npm run test:install-script && npm run test:protocol-migrations && npm run test:local-outbox && npm run test:skill-deposit && npm run test:axis-skills && npm run test:public-governance",
    "test:cli": "npm run build && node tests/cli-install.test.mjs",
    "test:install-script": "node tests/install-script.test.mjs",
    "test:local-outbox": "npm run build && node tests/local-outbox.test.mjs",
    "test:protocol-migrations": "npm run build && node tests/protocol-migrations.test.mjs",
    "test:skill-deposit": "node tests/skill-deposit.test.mjs",
    "test:axis-skills": "node tests/axis-skills.test.mjs",
    "test:public-governance": "node tests/public-governance.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ali-oss": "^6.23.0",
    "yaml": "^2.9.0"
  }
}
